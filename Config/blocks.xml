<?xml version="1.0" encoding="UTF-8"?>

<configs>

    <append xpath="/blocks">

        <!-- ====================================================== -->
        <!-- CYB-003 Security Window Shape Controller               -->
        <!-- ====================================================== -->
        <!--
            Custom Shape Controller for all CYB Security Windows.

            Provides the shared material, repair, sound and crafting
            behaviour for every CYB window shape.

            Individual window geometry and stage behaviour are
            defined in shapes.xml and generated by the vanilla
            Shape Controller system at runtime.
        -->

        <block name="cybSecurityWindowShapes" shapes="CYBWindows">

            <property name="CustomIcon" value="CYB-Crate"/>
            <property name="DescriptionKey" value="cntCybSecurityWindowsDesc" />
            <property name="Material" value="McybSecurityWindow" />
            <property name="Shape" value="New" />

            <property name="SelectAlternates" value="true" />

            <property name="Texture" value="241" />
            <property name="UiBackgroundTexture" value="241" />
            <property name="LightOpacity" value="2" />

            <property name="EconomicValue" value="0" />
            <property name="EconomicBundleSize" value="1" />
            <property name="SellableToTrader" value="false" />

            <property class="RepairItems">
                <property name="cybSecurityResin" value="1" />
            </property>

            <drop event="Harvest"
                  name="resourceBrokenGlass"
                  count="21"
                  tag="allHarvest" />

            <drop event="Destroy" count="0" />
            <drop event="Fall" count="0" />

            <property name="UpgradeSound" value="place_block_metal" />
            <property name="SoundPickup" value="metalblock_grab" />
            <property name="SoundPlace" value="steelblock_place" />

            <property name="SortOrder1" value="S000" />

            <property name="Group" value="Building,advBuilding" />
            <property name="Tags" value="CYBWindows" />
            <property name="FilterTags" value="MC_Shapes" />

        </block>

    </append>

</configs>