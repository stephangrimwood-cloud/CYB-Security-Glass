<?xml version="1.0" encoding="UTF-8"?>

<configs>

    <append xpath="/recipes">

        <!-- ====================================================== -->
        <!-- CYB-001 Security Resin                                -->
        <!-- ====================================================== -->

        <recipe name="cybSecurityResin"
                count="1"
                craft_area="chemistryStation"
                craft_time="6"
                tags="perkAdvancedEngineering,chemStationCrafting">

            <ingredient name="resourceBrokenGlass" count="5" />
            <ingredient name="resourceGlue" count="1" />
            <ingredient name="resourceScrapPolymers" count="3" />

        </recipe>

        <recipe name="cybSecurityResin"
                count="1"
                craft_area="campfire"
                craft_tool="toolCookingPot"
                craft_time="40"
                tags="perkAdvancedEngineering,cookingPotChem">

            <ingredient name="resourceBrokenGlass" count="7" />
            <ingredient name="resourceGlue" count="2" />
            <ingredient name="resourceScrapPolymers" count="5" />

        </recipe>


        <!-- ====================================================== -->
        <!-- CYB-002 Tempered Glass Panel                          -->
        <!-- ====================================================== -->

        <recipe name="cybTemperedGlassPanel"
                count="1"
                material_based="true"
                craft_area="forge"
                craft_tool="toolForgeCrucible"
                tags="use_smelter,perkAdvancedEngineering">

            <ingredient name="unit_glass" count="100" />
            <ingredient name="unit_stone" count="8" />
            <ingredient name="unit_lead" count="35" />
            <ingredient name="unit_iron" count="16" />
            <ingredient name="unit_clay" count="16" />

            <effect_group>

                <passive_effect name="CraftingIngredientCount"
                                operation="perc_add"
                                level="0,1,2,3,4"
                                value=".25,.25,.25,.12,.06"
                                tags="unit_clay,unit_stone,unit_glass,unit_iron,unit_lead" />

            </effect_group>

        </recipe>

        <!-- ====================================================== -->
        <!-- CYB-003 Security Window (VariantHelper)                -->
        <!-- ====================================================== -->

        <recipe name="cybSecurityWindowShapes:VariantHelper"
                count="1"
                craft_area="workbench"
                craft_time="40"
                tags="perkAdvancedEngineering">

            <ingredient name="resourceForgedIron" count="10" />
            <ingredient name="cybTemperedGlassPanel" count="2" />
            <ingredient name="cybSecurityResin" count="1" />
            <ingredient name="resourceMechanicalParts" count="4" />

        </recipe>

        <!-- ====================================================== -->
        <!-- CYB-004 Industrial Toolkit                             -->
        <!-- ====================================================== -->

        <recipe name="cybIndustrialToolkit"
                count="1"
                craft_area="workbench"
                craft_time="270"
                tags="perkAdvancedEngineering">

            <ingredient name="meleeToolSalvageT3ImpactDriver" count="1"/>
            <ingredient name="cybSecurityResin" count="12"/>
            <ingredient name="resourceDuctTape" count="4"/>
            <ingredient name="resourceForgedIron" count="100"/>
            <ingredient name="resourceMechanicalParts" count="80"/>

        </recipe>

    </append>

</configs>