<!--
==================================================================
CYB-002 – CYB Tempered Glass Panel

Type: Item
Status: Complete / Signed Off

Source: items.xml

Description:
Defines the CYB Tempered Glass Panel inventory item.

Represents the intermediate manufactured component
used in the assembly of CYB Security Windows.

Dependencies:
- localisation.csv
- recipes.xml
- UIAtlas icon: glassCYBTemperedPanel

Outstanding:
- None

==================================================================
-->

    <item name="cybTemperedGlassPanel">
            <!-- Keeps scrap recovery limited to Broken Glass fragments. -->
            <property name="Tags" value="junk"/>
            <property name="HoldType" value="45"/>
            <property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
            <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
            <property name="Material" value="Mglass"/>
            <property name="Weight" value="8"/>
            <property name="Stacknumber" value="500"/>

            <!-- Intrinsic value based on approximately 20% reduced manufacturing cost versus vanilla Bulletproof Glass Plate. -->
            <property name="EconomicValue" value="120"/>

            <!-- Prevents specialist CYB manufacturing components being sold to traders. -->
            <property name="SellableToTrader" value="false"/>

            <property name="Group" value="Resources"/>
            <property name="CustomIcon" value="glassCYBTemperedPanel"/>
        </item>