<!--
==================================================================
CYB-001 – CYB Security Resin

Type: Item
Status: Production Ready

Source: items.xml

Description:
Defines the CYB Security Resin inventory item.

Dependencies:
- localisation.csv
- recipes.xml

==================================================================
-->

<configs>

    <append xpath="/items">

        <item name="cybSecurityResin">
            <property name="HoldType" value="45"/>
            <property name="Tags" value="junk"/>
            <property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
            <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
            <property name="Material" value="Morganic"/>
            <property name="Weight" value="10"/>
            <property name="Stacknumber" value="500"/>
            <property name="EconomicValue" value="20"/>
            <property name="Group" value="Resources,Chemicals,CFChemicals"/>
            <property name="SoundPickup" value="glue_grab"/>
            <property name="SoundPlace" value="glue_place"/>
            <property name="CustomIcon" value="cybSecurityResin"/>

            <!-- Intermediate manufacturing component. Not intended for trader sale. -->
            <property name="SellableToTrader" value="false"/>
        </item>


    </append>

</configs>